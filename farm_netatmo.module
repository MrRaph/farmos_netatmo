<?php

use Drupal\asset\Entity\AssetInterface;
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Field\BaseFieldDefinition;

/**
 * Implémente hook_cron().
 *
 * - Crée les assets manquants pour chaque module Netatmo.
 * - Alimente la queue farm_netatmo_sync.
 */
function farm_netatmo_cron() {
  /** @var \Drupal\farm_netatmo\NetatmoService $api */
  $api     = \Drupal::service('farm_netatmo.netatmo_service');
  $storage = \Drupal::entityTypeManager()->getStorage('asset');
  $queue   = \Drupal::queue('farm_netatmo_sync');

  try {
    $devices = $api->listDevices();
  }
  catch (\Throwable $e) {
    \Drupal::logger('farm_netatmo')->error($e->getMessage());
    return;
  }

  $created = 0;
  foreach ($devices as $d) {
    $device_id   = $d['module_id']   ?? $d['device_id'] ?? NULL;
    $device_name = $d['module_name'] ?? $d['station_name'] ?? 'Netatmo';

    if (!$device_id) {
      continue;
    }

    // Charge ou crée l’asset sensor.
    $ids = \Drupal::entityQuery('asset')
      ->condition('type', 'sensor')
      ->condition('field_netatmo_device_id', $device_id)
      ->execute();

    if ($ids) {
      $asset = $storage->load(reset($ids));
    }
    else {
      /** @var AssetInterface $asset */
      $asset = $storage->create([
        'type' => 'sensor',
        'name' => 'Netatmo – ' . $device_name,
        'field_netatmo_device_id' => $device_id,
      ]);
      $asset->save();
      $created++;
    }

    // Ajoute à la queue
    $queue->createItem($asset->id());
  }

  \Drupal::logger('farm_netatmo')->notice(
    'Netatmo cron : @new assets créés, @all modules en file.',
    ['@new' => $created, '@all' => count($devices)],
  );
}

/**
 * Implements hook_entity_base_field_info_alter().
 */
function farm_netatmo_entity_base_field_info_alter(&$fields, EntityTypeInterface $entity_type) {
  if ($entity_type->id() === 'asset' && isset($fields['parents'])) {
    // Autoriser le champ parents sur les capteurs.
    $fields['parents']->setTargetBundles(['sensor' => 'sensor']);
  }
}
